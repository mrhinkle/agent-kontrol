# Postgres connection string. Neon hostnames use Neon's serverless HTTP driver;
# any other Postgres 13+ uses node-postgres. See docs/DATABASE.md.
# Vercel-managed Neon injects DATABASE_URL automatically.
# Local: create a project at neon.tech and copy the connection string.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Shared secret for agents reporting in (ingest API + MCP server).
# Generate one: openssl rand -hex 24
MC_TOKEN=change-me

# Password gate for the dashboard UI (leave unset to disable, e.g. local dev).
# Agents are unaffected — they authenticate with MC_TOKEN.
MC_DASHBOARD_PASSWORD=change-me-too

# Optional: separate HMAC key for the auth cookie (falls back to MC_TOKEN).
# Rotate it to revoke all dashboard sessions.
# MC_COOKIE_SECRET=

# Optional: HS256 signing key for OAuth access/refresh JWTs (falls back to
# MC_COOKIE_SECRET, then MC_TOKEN). Rotate to revoke all OAuth sessions.
# MC_OAUTH_SECRET=

# Optional: canonical public origin for OAuth issuer/metadata (e.g.
# https://agent-kontrol.example.com). When unset, derived from request
# Host / X-Forwarded-* headers.
# MC_PUBLIC_URL=

# Optional: name shown in the dashboard header
NEXT_PUBLIC_MC_NAME="Agent Kontrol"

# Optional: your name, shown as the sender of dashboard messages to agents.
# NEXT_PUBLIC_MC_OPERATOR=Operator

# Optional: link target for the Hermes vitals/heartbeat page, shown as one line
# in the progress board's fleet strip. Unset hides the link.
# NEXT_PUBLIC_HERMES_VITALS_URL=

# Usage and Costs (Phase 1) — names only; values go in Vercel / Mini env (mode 600)
# MC_OPENROUTER_MANAGEMENT_KEY=
# Optional: path to cron id→name JSON (defaults to tests/fixtures/cron-job-names.json in-repo)
# MC_CRON_NAMES_JSON=
