{
  "audit": {
    "url": "https://YOUR-DEPLOY.vercel.app",
    "token": "secretref://file/default/AK_BROKER_AUDIT_TOKEN"
  },
  "github": {
    "app_id": 123456,
    "private_key": "secretref://exec/keychain/AK_GITHUB_APP_KEY",
    "permissions": {"contents": "write", "pull_requests": "write"},
    "api": "https://api.github.com"
  },
  "admin_socket": "/abs/path/private-0700-dir/broker-admin.sock",
  "bind": "127.0.0.1",
  "port": 8765,
  "providers": "/abs/path/providers.json",
  "placeholder_ttl_seconds": 3600,
  "upstream_timeout_seconds": 60,
  "max_request_body_bytes": 1048576,
  "services": [
    {
      "name": "openrouter",
      "upstream": "https://openrouter.ai",
      "header": "Authorization",
      "template": "Bearer {secret}",
      "secret": "secretref://file/default/OPENROUTER_API_KEY",
      "methods": ["GET", "POST"],
      "path_prefixes": ["/api/v1/"],
      "env_key": "OPENROUTER_API_KEY",
      "env_base_url": "OPENROUTER_BASE_URL"
    }
  ]
}
