#!/usr/bin/env python3
"""git credential helper for broker-issued GitHub tokens (#190). Stdlib only. Python 3.9.

The dispatcher sets it, through the child environment only, as the one
credential helper for https://github.com, together with AK_GITHUB_PLACEHOLDER,
AK_BROKER_URL and AK_GITHUB_REPO. ``get`` posts the task's repository to the
broker's loopback ``POST /_github/token`` and prints the installation token.

Any doubt means no credential: non-zero exit and empty stdout. ``store``,
``erase``, other actions, other protocols and other hosts print nothing and
exit 0. Nothing is written to stderr except a fixed code, never a value.
"""
from __future__ import annotations

import json
import os
import re
import socket
import sys
import time

MAX_INPUT = 65536
MAX_RESPONSE = 65536
TIMEOUT_SECONDS = 15.0
_PLACEHOLDER_RE = re.compile(r"akp_[A-Za-z0-9_-]{43}\Z")
_BROKER_URL_RE = re.compile(r"http://127\.0\.0\.1:([1-9][0-9]{0,4})\Z")
_OWNER_RE = re.compile(r"[A-Za-z0-9-]{1,39}\Z")
_NAME_RE = re.compile(r"[A-Za-z0-9._-]{1,100}\Z")
_KEY_RE = re.compile(r"[a-z_]+(\[\])?\Z")
_SINGLE = frozenset(("protocol", "host", "path"))
# Informational keys git itself sends on ``get`` (git 2.41+: wwwauth[]; 2.46+: capability[]).
# They are read and ignored; they can never carry a credential back to git.
_IGNORED_MULTI = frozenset(("wwwauth[]", "capability[]"))


class Refused(Exception):
    """No credential. The message is a fixed code."""


def _valid_repo(value: str) -> bool:
    if value.count("/") != 1:
        return False
    owner, name = value.split("/")
    return _OWNER_RE.fullmatch(owner) is not None and _NAME_RE.fullmatch(name) is not None and name not in (".", "..")


def _read_stdin() -> bytes:
    data = b""
    stream = sys.stdin.buffer
    while True:
        block = stream.read(MAX_INPUT + 1 - len(data))
        if not block:
            return data
        data += block
        if len(data) > MAX_INPUT:
            raise Refused("input_too_large")


def parse_request(data: bytes) -> dict:
    """The credential description. Raises ``Refused`` on anything malformed (H12, D5)."""
    if b"\r" in data or b"\x00" in data:
        raise Refused("bad_input")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("bad_input") from None
    # Terminated by a blank line, or by end of input after a final newline,
    # which is what git sends to helpers. Nothing may follow the blank line.
    if text.endswith("\n\n"):
        body = text[:-1]
    elif text.endswith("\n") and text != "\n":
        body = text
    else:
        raise Refused("bad_input")
    lines = body[:-1].split("\n")
    fields: dict = {}
    for line in lines:
        if line == "":
            raise Refused("bad_input")
        key, sep, value = line.partition("=")
        if not sep or _KEY_RE.fullmatch(key) is None:
            raise Refused("bad_input")
        if key in _IGNORED_MULTI:
            continue
        if key not in _SINGLE:
            # username, password, and every other field.
            raise Refused("bad_input")
        if key in fields:
            raise Refused("bad_input")
        fields[key] = value
    if "protocol" not in fields or "host" not in fields:
        raise Refused("bad_input")
    return fields


def _settings(environ: dict) -> tuple:
    placeholder = environ.get("AK_GITHUB_PLACEHOLDER", "")
    broker_url = environ.get("AK_BROKER_URL", "")
    repo = environ.get("AK_GITHUB_REPO", "")
    if _PLACEHOLDER_RE.fullmatch(placeholder) is None:
        raise Refused("bad_environment")
    match = _BROKER_URL_RE.fullmatch(broker_url)
    if match is None or int(match.group(1)) > 65535:
        raise Refused("bad_environment")
    if not _valid_repo(repo):
        raise Refused("bad_environment")
    return placeholder, int(match.group(1)), repo


def _remaining(deadline: float) -> float:
    left = deadline - time.monotonic()
    if left <= 0:
        raise Refused("timeout")
    return left


def _post(port: int, placeholder: str, repo: str) -> bytes:
    """One request over a direct loopback socket: no proxy variable is consulted (H16)."""
    deadline = time.monotonic() + TIMEOUT_SECONDS
    body = json.dumps({"repository": repo}, separators=(",", ":")).encode("ascii")
    request = (
        "POST /_github/token HTTP/1.1\r\n"
        "Host: 127.0.0.1:%d\r\n"
        "Authorization: Bearer %s\r\n"
        "Content-Type: application/json\r\n"
        "Content-Length: %d\r\n"
        "Connection: close\r\n\r\n" % (port, placeholder, len(body))
    ).encode("ascii") + body
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    except OSError:
        raise Refused("unreachable") from None
    try:
        sock.settimeout(_remaining(deadline))
        sock.connect(("127.0.0.1", port))
        sock.settimeout(_remaining(deadline))
        sock.sendall(request)
        raw = b""
        while True:
            sock.settimeout(_remaining(deadline))
            block = sock.recv(65536)
            if not block:
                break
            raw += block
            if len(raw) > MAX_RESPONSE + 8192:
                raise Refused("response_too_large")
    except (OSError, socket.timeout):
        raise Refused("unreachable") from None
    finally:
        sock.close()
    return raw


def _pairs(pairs: list) -> dict:
    obj: dict = {}
    for key, value in pairs:
        if key in obj:
            raise ValueError("duplicate")
        obj[key] = value
    return obj


def _constant(_token: str) -> None:
    raise ValueError("constant")


def parse_response(raw: bytes) -> str:
    """The token from a 200 JSON response. Raises ``Refused`` otherwise (D5)."""
    head_end = raw.find(b"\r\n\r\n")
    if head_end < 0:
        raise Refused("malformed_response")
    head = raw[:head_end].split(b"\r\n")
    status_parts = head[0].split(b" ", 2)
    if len(status_parts) < 2 or status_parts[0] not in (b"HTTP/1.0", b"HTTP/1.1"):
        raise Refused("malformed_response")
    if status_parts[1] != b"200":
        # A redirect, a refusal, or anything else.
        raise Refused("refused")
    headers: dict = {}
    for line in head[1:]:
        name, sep, value = line.partition(b":")
        if not sep:
            raise Refused("malformed_response")
        key = name.strip().lower()
        if key in headers:
            raise Refused("malformed_response")
        headers[key] = value.strip()
    if b"transfer-encoding" in headers:
        raise Refused("malformed_response")
    content_type = headers.get(b"content-type", b"").split(b";", 1)[0].strip().lower()
    if content_type != b"application/json":
        raise Refused("malformed_response")
    body = raw[head_end + 4:]
    length = headers.get(b"content-length")
    if length is not None:
        if not length.isdigit() or len(length) > 6 or int(length) != len(body):
            raise Refused("malformed_response")
    if len(body) > MAX_RESPONSE:
        raise Refused("response_too_large")
    try:
        data = json.loads(body.decode("utf-8"), object_pairs_hook=_pairs, parse_constant=_constant)
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Refused("malformed_response") from None
    if not isinstance(data, dict) or set(data) != {"token", "expires_at"}:
        raise Refused("malformed_response")
    token = data["token"]
    if type(data["expires_at"]) is not str or type(token) is not str or token == "":
        raise Refused("malformed_response")
    if not token.isascii() or not token.isprintable() or any(ch.isspace() for ch in token):
        raise Refused("malformed_response")
    return token


def main(argv: list) -> int:
    action = argv[1] if len(argv) == 2 else ""
    if action != "get":
        # store, erase and unknown actions: nothing to do, nothing printed.
        return 0
    try:
        fields = parse_request(_read_stdin())
        if fields["protocol"] != "https" or fields["host"] != "github.com":
            return 0
        placeholder, port, repo = _settings(dict(os.environ))
        token = parse_response(_post(port, placeholder, repo))
    except Refused as exc:
        sys.stderr.write("git-credential-ak: %s\n" % exc)
        return 1
    except Exception:  # noqa: BLE001 - never a traceback with request data
        sys.stderr.write("git-credential-ak: error\n")
        return 1
    sys.stdout.write("username=x-access-token\npassword=%s\n\n" % token)
    sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
